FLASK_ENV=development
SECRET_KEY=dev-change-me

# NOAA NWS API requires a descriptive User-Agent with contact info per its
# usage policy: https://www.weather.gov/documentation/services-web-api
# Fill in your own app name + contact email/URL locally. Do not commit
# real contact info anywhere else in the repo.
NWS_USER_AGENT=crowdsurf-it401 (your-email@example.com)

# Outbound HTTP timeout (seconds) used by every external data service
EXTERNAL_API_TIMEOUT=10

# Seconds a break page's live data is reused before every source is fetched
# again (0 = always fetch fresh). Saves a second full fetch after "Save".
PANEL_CACHE_SECONDS=300

# RapidAPI key for the WeatherAPI.com Marine "second opinion" forecast.
# Subscribe (free Basic plan) at https://rapidapi.com/weatherapi/api/weatherapi-com
# then copy your X-RapidAPI-Key here. Without it, that one tab says
# "unavailable" and everything else still works.
RAPIDAPI_KEY=

# Claude API key for the AI summary (https://console.anthropic.com).
# Without it, the "Summarize" button shows a message instead of calling the API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Cloud MySQL (CI-Keys), A3+. Reached through an SSH tunnel opened locally
# (see .claude/rules/database.md). Placeholders only -- real values go in .env.
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=your_db_name
