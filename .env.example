FLASK_ENV=development
SECRET_KEY=dev-change-me

# NOAA NWS API requires a descriptive User-Agent with contact info per its
# usage policy: https://www.weather.gov/documentation/services-web-api
# Fill in your own app name + contact email/URL locally. Do not commit
# real contact info anywhere else in the repo.
NWS_USER_AGENT=crowdsurf-it401 (your-email@example.com)

# Outbound HTTP timeout (seconds) used by every external data service
EXTERNAL_API_TIMEOUT=10

# Reserved for any future keyed source. Every A2 data source (Open-Meteo,
# NOAA NWS/CO-OPS/SPC, RainViewer, NDBC) is free and keyless, so these are
# unused right now -- left here so config.py never needs a hardcoded key
# if a keyed source is added later.
API_KEY=
AI_SERVICE_API_KEY=
